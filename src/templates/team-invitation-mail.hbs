<!doctype html>
<html>
<body>
<div
  style='background-color:#1bb17a;color:#242424;font-family:"Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial, sans-serif;font-size:16px;font-weight:400;letter-spacing:0.15008px;line-height:1.5;margin:0;padding:32px 0;min-height:100%;width:100%'
>
  <table
    align="center"
    width="100%"
    style="margin:0 auto;max-width:600px;background-color:#ffffff;border-radius:16px"
    role="presentation"
    cellspacing="0"
    cellpadding="0"
    border="0"
  >
    <tbody>
    <tr style="width:100%">
      <td>
        <div style="padding:16px 24px 16px 24px">
          <table
            align="center"
            width="100%"
            cellpadding="0"
            border="0"
            style="table-layout:fixed;border-collapse:collapse"
          >
            <tbody style="width:100%">
            <tr style="width:100%">
              <td
                style="box-sizing:content-box;vertical-align:middle;padding-left:0;padding-right:8px"
              >
                <div
                  style="padding:16px 24px 16px 24px;text-align:center"
                >
                  <a
                    href="https://cslabs.be"
                    style="text-decoration:none"
                    target="_blank"
                  ><img
                    alt="CSLabs Logo"
                    src="https://i.ibb.co/KsHbxLb/Logo-CSLabs-Transparent.png"
                    height="100"
                    style="height:100px;outline:none;border:none;text-decoration:none;vertical-align:middle;display:inline-block;max-width:100%"
                  /></a>
                </div>
              </td>
              <td
                style="box-sizing:content-box;vertical-align:middle;padding-left:8px;padding-right:0"
              >
                <div
                  style="padding:16px 24px 16px 24px;text-align:center"
                >
                  <a
                    href="https://hackathon.cslabs.be"
                    style="text-decoration:none"
                    target="_blank"
                  ><img
                    alt="Hackathon 2025 Logo"
                    src="https://i.ibb.co/jknFYwy/logo.png"
                    height="100"
                    style="height:100px;outline:none;border:none;text-decoration:none;vertical-align:middle;display:inline-block;max-width:100%"
                  /></a>
                </div>
              </td>
            </tr>
            </tbody>
          </table>
        </div>
        <h2
          style="font-weight:bold;text-align:center;margin:0;font-size:24px;padding:16px 24px 16px 24px"
        >
          Bienvenue à l&#x27;édition 2025 de notre Hackathon !
        </h2>
        <div
          style="font-size:18px;font-weight:bold;text-align:center;padding:0px 24px 8px 24px"
        >
          Vous avez reçu une invitation à rejoindre l&#x27;équipe
          &quot;{{teamName}}&quot; ! 🥳
        </div>
        <div
          style="font-size:16px;font-weight:normal;text-align:center;padding:0px 24px 16px 24px"
        >
          Nous vous conseillons de lire attentivement ce mail afin de ne
          rien oublier le jour J 😉
        </div>
        <h3
          style="font-weight:bold;text-align:center;margin:0;font-size:20px;padding:16px 24px 16px 24px"
        >
          Informations utiles
        </h3>
        <div style="font-size:16px;padding:16px 24px 0px 24px">
          Votre participation au Hackathon n'est effective qu'à partir du
          moment où votre caution est payée. Vous pouvez vérifier la
          validation de votre caution sur
          <a href="https://hackathon.cslabs.be/team/user">votre profil</a
          >.
        </div>
        <div style="font-size:16px;padding:0px 24px 0px 24px">
          <ul>
            <li>Montant : 20€</li>
            <li>Compte : <b>{{iban}}</b></li>
            <li>Communication : <b>NOM Prénom</b></li>
          </ul>
        </div>
        <div
          style="font-size:16px;font-weight:normal;padding:0px 24px 16px 24px"
        >
          Une équipe possède au maximum 5 membres.
        </div>
        <div
          style="font-size:16px;text-align:center;padding:16px 24px 16px 24px"
        >
          N'hésitez pas à prendre contact avec notre équipe via
          <a href="https://discord.gg/Jf2Dht8"
          >le serveur Discord du Hackathon</a
          >, ou via cette adresse email !
        </div>
        <div
          style="font-size:16px;text-align:center;padding:16px 24px 16px 24px"
        >
          <div>
            <!--[if mso]>
  <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word"
               href="https://hackathon.cslabs.be/team/join/{{teamToken}}"
               style="height:40px;v-text-anchor:middle;width:300px;" arcsize="10%" stroke="f" fillcolor="#56b65a">
    <w:anchorlock />
    <center>
  <![endif]-->
            <a
              href="https://hackathon.cslabs.be/team/join/{{teamToken}}"
              style="color:#FFFFFF;font-size:16px;font-weight:bold;background-color:#56b65a;border-radius:4px;display:inline-block;padding:16px 32px;text-decoration:none"
              target="_blank"
            >Rejoindre votre équipe</a
            >
            <!--[if mso]>
            </center>
            </v:roundrect>
            <![endif]-->
          </div>
        </div>
        <div style="font-weight:normal;padding:12px 24px 0px 24px">
          Au plaisir de vous voir,
        </div>
        <div style="font-weight:normal;padding:0px 24px 16px 24px">
          L&#x27;équipe organisatrice.
        </div>
        <div style="padding:16px 0px 24px 0px">
          <hr
            style="width:100%;border:none;border-top:1px solid #CCCCCC;margin:0"
          />
        </div>
        <div
          style="font-size:10px;text-align:center;padding:0px 16px 24px 16px"
        >
          <div style="display: inline;">
            <a
              href="https://cslabs.be"
              style="margin: 0px 15px 0px 0px; color: transparent;"
            >
              <img
                alt="Homepage"
                src="https://i.ibb.co/p2fwr6W/Link.png"
              />
            </a>
            <a
              href="https://www.facebook.com/ComputerScienceLabs"
              style="margin: 0px 15px 0px 0px; color: transparent;"
            >
              <img
                alt="Facebook CSLabs"
                src="https://i.ibb.co/0V5sW5n/Facebook.png"
              />
            </a>
            <a
              href="https://www.instagram.com/cslabs_namur"
              style="margin: 0px 15px 0px 0px; color: transparent;"
            >
              <img
                alt="Instagram CSLabs"
                src="https://i.ibb.co/ct42ZsM/Instagram.png"
              />
            </a>
            <a
              href="https://www.linkedin.com/company/cslabs-namur"
              style="margin: 0px 15px 0px 0px; color: transparent;"
            >
              <img
                alt="LinkedIn CSLabs"
                src="https://i.ibb.co/6nyMJd2/LinkedIn.png"
              />
            </a>
            <a
              href="https://twitter.com/CSLabs"
              style="margin: 0px 15px 0px 0px; color: transparent;"
            >
              <img
                alt="Twitter/X CSLabs"
                src="https://i.ibb.co/zfCZDtR/Twitter.png"
              />
            </a>
            <a
              href="https://www.youtube.com/@CSLabs_Namur"
              style="color: transparent;"
            >
              <img
                alt="YouTube CSLabs"
                src="https://i.ibb.co/pXq2yPc/YouTube.png"
              />
            </a>
          </div>
        </div>
      </td>
    </tr>
    </tbody>
  </table>
</div>
</body>
</html>
